{
  "manifest_version": 3,
  "name": "AnimeSaturn Tracker",
  "version": "1.0.0",
  "description": "Traccia gli episodi visti su AnimeSaturn, li sincronizza tra i tuoi dispositivi (Firefox Sync / Chrome Sync) e aggiorna la tua lista MyAnimeList.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "animesaturn-tracker@local.ext",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "*://*.animesaturn.net/*",
    "*://*.animesaturn.me/*",
    "*://*.animesaturn.cx/*",
    "*://*.animesaturn.tv/*",
    "*://*.animesaturn.in/*",
    "*://*.animesaturn.mx/*",
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "scripts": [
      "lib/common.js",
      "lib/mal_api.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.animesaturn.net/*",
        "*://*.animesaturn.me/*",
        "*://*.animesaturn.cx/*",
        "*://*.animesaturn.tv/*",
        "*://*.animesaturn.in/*",
        "*://*.animesaturn.mx/*"
      ],
      "js": [
        "lib/common.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AnimeSaturn Tracker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
